{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "claim": {
      "type": "string",
      "minLength": 1
    },
    "evidence": {
      "type": "string",
      "minLength": 1
    },
    "rule": {
      "type": "string",
      "minLength": 1
    },
    "risk": {
      "type": "string",
      "minLength": 1
    },
    "fix": {
      "type": "string",
      "minLength": 1
    },
    "category": {
      "enum": [
        "legal",
        "truth",
        "conversion",
        "accessibility",
        "trust"
      ]
    },
    "severity": {
      "enum": [
        "critical",
        "high",
        "medium",
        "low"
      ]
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    }
  },
  "required": [
    "id",
    "title",
    "claim",
    "evidence",
    "rule",
    "risk",
    "fix",
    "category",
    "severity",
    "confidence"
  ],
  "additionalProperties": false
}
