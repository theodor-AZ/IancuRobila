      "description": "Beam-filled action that starts or changes a scan (New scan, Run scan).",
      "html": "<button class=\"ds-btn-primary\"><svg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" aria-hidden=\"true\"><path d=\"M5 12h14M12 5v14\"/></svg>New scan</button>",
      "css": ".ds-btn-primary{font-family:var(--font-geist-sans),ui-sans-serif,system-ui,sans-serif;display:inline-flex;align-items:center;gap:6px;height:32px;padding:0 10px;border:1px solid transparent;border-radius:8px;background:var(--primary);color:var(--primary-foreground);font-size:14px;font-weight:500;cursor:pointer;transition:all .15s}.ds-btn-primary:hover{background:color-mix(in oklch,var(--primary) 80%,transparent)}.ds-btn-primary:focus-visible{outline:none;border-color:var(--ring);box-shadow:0 0 0 3px color-mix(in oklch,var(--ring) 50%,transparent)}.ds-btn-primary:active{transform:translateY(1px)}"
    },
    {
      "name": "Outline Button",
      "kind": "button",
      "refersTo": "button-outline",
      "description": "Hairline secondary action (Export PDF, Copy fix).",
      "html": "<button class=\"ds-btn-outline\"><svg width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" aria-hidden=\"true\"><path d=\"M12 15V3M7 10l5 5 5-5M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4\"/></svg>Export PDF</button>",
      "css": ".ds-btn-outline{font-family:var(--font-geist-sans),ui-sans-serif,system-ui,sans-serif;display:inline-flex;align-items:center;gap:4px;height:28px;padding:0 10px;border:1px solid var(--input);border-radius:8px;background:color-mix(in oklch,var(--input) 30%,transparent);color:var(--foreground);font-size:13px;font-weight:500;cursor:pointer;transition:all .15s}.ds-btn-outline:hover{background:color-mix(in oklch,var(--input) 50%,transparent)}.ds-btn-outline:focus-visible{outline:none;border-color:var(--ring);box-shadow:0 0 0 3px color-mix(in oklch,var(--ring) 50%,transparent)}.ds-btn-outline:active{transform:translateY(1px)}"
    },
    {
      "name": "Text Input",
      "kind": "input",
      "refersTo": "input",
      "description": "Hairline field; URLs typed in tabular mono.",
      "html": "<input class=\"ds-input\" value=\"https://glowpure.example/hydra-cream\" aria-label=\"Landing page URL\">",
      "css": ".ds-input{font-family:var(--font-geist-mono),ui-monospace,monospace;font-variant-numeric:tabular-nums slashed-zero;height:32px;width:320px;padding:4px 10px;border:1px solid var(--input);border-radius:8px;background:color-mix(in oklch,var(--input) 30%,transparent);color:var(--foreground);font-size:14px;transition:border-color .15s,box-shadow .15s}.ds-input:focus-visible{outline:none;border-color:var(--ring);box-shadow:0 0 0 3px color-mix(in oklch,var(--ring) 50%,transparent)}"
    },
    {
      "name": "Main Navigation",
      "kind": "nav",
      "refersTo": "nav-link-active",
      "description": "Header links; the active link gets the secondary console fill.",
      "html": "<nav class=\"ds-nav\"><a class=\"ds-nav-link is-active\" href=\"#\" aria-current=\"page\">Scans</a><a class=\"ds-nav-link\" href=\"#\">Style guide</a></nav>",
      "css": ".ds-nav{font-family:var(--font-geist-sans),ui-sans-serif,system-ui,sans-serif;display:flex;gap:4px;align-items:center;padding:12px 16px;border-bottom:1px solid var(--border);background:var(--background)}.ds-nav-link{padding:6px 10px;border-radius:4px;font-size:14px;color:var(--muted-foreground);text-decoration:none;transition:color .15s}.ds-nav-link:hover{color:var(--foreground)}.ds-nav-link:focus-visible{outline:2px solid var(--ring);outline-offset:2px}.ds-nav-link.is-active{background:var(--secondary);color:var(--foreground)}"
    },
    {
      "name": "Filter Tabs",
      "kind": "chip",
      "refersTo": "filter-tab-selected",
      "description": "Category filter with mono counts above the findings.",
      "html": "<div class=\"ds-tabs\" role=\"tablist\"><button class=\"ds-tab is-on\" role=\"tab\" aria-selected=\"true\">All <span>12</span></button><button class=\"ds-tab\" role=\"tab\">Legal <span>3</span></button><button class=\"ds-tab\" role=\"tab\">Truth <span>2</span></button></div>",
      "css": ".ds-tabs{font-family:var(--font-geist-sans),ui-sans-serif,system-ui,sans-serif;display:flex;gap:4px}.ds-tab{display:inline-flex;align-items:center;gap:6px;height:28px;padding:0 10px;border:1px solid transparent;border-radius:4px;background:none;color:var(--muted-foreground);font:inherit;font-size:13px;cursor:pointer;transition:color .15s}.ds-tab span{font-family:var(--font-geist-mono),ui-monospace,monospace;font-variant-numeric:tabular-nums slashed-zero;color:var(--muted-foreground)}.ds-tab:hover{color:var(--foreground)}.ds-tab:focus-visible{outline:2px solid var(--ring);outline-offset:2px}.ds-tab.is-on{border-color:var(--border-strong);background:var(--secondary);color:var(--foreground)}"
    },
    {
      "name": "Severity Badge",
      "kind": "chip",
      "refersTo": "severity-badge-critical",
      "description": "Severity word plus a distinct icon on its tint; never colour alone.",
      "html": "<span class=\"ds-sev ds-sev-critical\"><svg width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.25\" aria-hidden=\"true\"><path d=\"M7.86 2h8.28L22 7.86v8.28L16.14 22H7.86L2 16.14V7.86z\"/><path d=\"M12 8v4M12 16h.01\"/></svg>Critical</span> <span class=\"ds-sev ds-sev-high\"><svg width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.25\" aria-hidden=\"true\"><path d=\"m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3\"/><path d=\"M12 9v4M12 17h.01\"/></svg>High</span>",
      "css": ".ds-sev{font-family:var(--font-geist-sans),ui-sans-serif,system-ui,sans-serif;display:inline-flex;align-items:center;gap:4px;height:24px;padding:0 8px;border-radius:4px;font-size:12px;font-weight:600;text-transform:uppercase;letter-spacing:.06em}.ds-sev-critical{background:var(--sev-critical-bg);color:var(--sev-critical-fg)}.ds-sev-high{background:var(--sev-high-bg);color:var(--sev-high-fg)}"
    },
    {
      "name": "Threat Frame",
      "kind": "custom",
      "refersTo": "frame-number-active",
      "description": "Signature: numbered, bracketed frame on a capture over the scan grid; hover or focus locks it with a severity halo.",
      "html": "<div class=\"ds-well\"><button class=\"ds-frame\" aria-label=\"Finding 02: discount differs\"><i class=\"tl\"></i><i class=\"tr\"></i><i class=\"bl\"></i><i class=\"br\"></i><span class=\"ds-frame-tag\">02</span></button></div>",
      "css": ".ds-well{position:relative;width:280px;height:160px;border:1px solid var(--border);border-radius:8px;background-color:color-mix(in oklch,var(--muted) 30%,transparent);background-image:linear-gradient(var(--scan-grid) 1px,transparent 1px),linear-gradient(90deg,var(--scan-grid) 1px,transparent 1px);background-size:24px 24px}.ds-frame{position:absolute;left:25%;top:35%;width:50%;height:40%;border:1.5px solid var(--sev-critical);color:var(--sev-critical);border-radius:2px;background:color-mix(in oklch,currentColor 5%,transparent);cursor:pointer;transition:opacity .2s cubic-bezier(.16,1,.3,1),box-shadow .2s cubic-bezier(.16,1,.3,1),background-color .2s cubic-bezier(.16,1,.3,1)}.ds-frame:hover,.ds-frame:focus-visible{outline:none;background:color-mix(in oklch,currentColor 12%,transparent);box-shadow:0 0 0 3px color-mix(in oklch,currentColor 30%,transparent)}.ds-frame i{position:absolute;width:8px;height:8px;border:0 solid currentColor}.ds-frame .tl{left:-3px;top:-3px;border-left-width:2px;border-top-width:2px}.ds-frame .tr{right:-3px;top:-3px;border-right-width:2px;border-top-width:2px}.ds-frame .bl{left:-3px;bottom:-3px;border-left-width:2px;border-bottom-width:2px}.ds-frame .br{right:-3px;bottom:-3px;border-right-width:2px;border-bottom-width:2px}.ds-frame-tag{position:absolute;left:0;top:-2px;transform:translateY(-100%);display:grid;place-items:center;height:18px;min-width:18px;padding:0 4px;border-radius:2px 2px 0 0;background:var(--sev-critical);color:var(--background);font-family:var(--font-geist-mono),ui-monospace,monospace;font-variant-numeric:tabular-nums slashed-zero;font-size:11px;font-weight:600}"
    },
    {
      "name": "Findings Register",
      "kind": "custom",
      "refersTo": "report-panel",
      "description": "Pentest register: frame number, severity, finding; hover tints, selection takes the beam wash.",
      "html": "<table class=\"ds-reg\"><thead><tr><th>#</th><th>Severity</th><th>Finding</th></tr></thead><tbody><tr class=\"is-sel\"><td><span class=\"ds-num on\">01</span></td><td><span class=\"ds-sevs\">Critical</span></td><td>\"Buy Now\" leads to a page that does not exist (HTTP 404)</td></tr><tr><td><span class=\"ds-num\">02</span></td><td><span class=\"ds-sevs\">Critical</span></td><td>Discount in the ad differs from the landing page</td></tr></tbody></table>",
      "css": ".ds-reg{font-family:var(--font-geist-sans),ui-sans-serif,system-ui,sans-serif;width:440px;border-collapse:separate;border-spacing:0;border:1px solid var(--border);border-radius:8px;overflow:hidden;font-size:14px;color:var(--foreground)}.ds-reg thead{background:color-mix(in oklch,var(--muted) 50%,transparent);text-align:left;font-size:12px;text-transform:uppercase;letter-spacing:.06em;color:var(--muted-foreground)}.ds-reg th{padding:8px 10px;font-weight:600}.ds-reg td{padding:10px;border-top:1px solid var(--border);vertical-align:top}.ds-reg tbody tr{cursor:pointer;transition:background-color .15s}.ds-reg tbody tr:hover{background:color-mix(in oklch,var(--muted) 40%,transparent)}.ds-reg tr.is-sel{background:var(--accent)}.ds-num{display:inline-grid;place-items:center;height:20px;min-width:24px;padding:0 4px;border:1px solid var(--border-strong);border-radius:2px;font-family:var(--font-geist-mono),ui-monospace,monospace;font-variant-numeric:tabular-nums slashed-zero;font-size:11px;font-weight:600;color:var(--muted-foreground)}.ds-num.on{background:var(--sev-critical);border-color:transparent;color:var(--background)}.ds-sevs{display:inline-flex;height:20px;align-items:center;padding:0 6px;border-radius:4px;background:var(--sev-critical-bg);color:var(--sev-critical-fg);font-size:11px;font-weight:600;text-transform:uppercase;letter-spacing:.06em}"
    }
  ],
  "narrative": {
    "northStar": "The Screening Console",
    "overview": "ClaimGuard X looks like an airport X-ray screening console that writes a pentest report. The campaign goes through the scanner, and what comes out is an audit: a deep blue-black ground, neutrals tinted toward the scanner's blue, hairline 1px frames, small instrument corners, and one cyan beam that marks what you can touch and what is being scanned. Severity colours are the threat palette. They only appear where a threat is being reported.\n\nDensity is report density, not dashboard density. Screens are built from bordered sections and a findings register, not from score tiles or same-size cards. The only big number is the campaign score on its tick-marked dial. Everything that is a measurement (scores, IDs, timings, URLs, counts) is set in tabular Geist Mono, and everything else is Geist Sans.\n\nDark is the default theme (`<html class=\"dark\">`). Light is the same system tuned for daylight and print, not a separate brand. Both themes are held to WCAG 2.2 AA contrast, and severity is never shown by colour alone.",
    "keyCharacteristics": [
      "Blue-black console ground, blue-tinted neutrals, one cyan beam accent.",
      "Four-step threat palette (critical, high, medium, low), each in solid, text and tint roles.",
      "Numbered threat frames with corner brackets drawn on the evidence captures, linked to matching rows in the findings table.",
      "Tabular mono for every measurement; sans for everything else.",
      "Hairline 1px borders and 2 to 8px radii; depth comes from tone, not shadows."
    ],
    "rules": [
      {
        "name": "The One Beam Rule",
        "body": "Cyan means \"interactive or scanning\". It is never decoration, never a severity, and never a second brand colour.",
        "section": "colors"
      },
      {
        "name": "The Threat Palette Rule",
        "body": "Severity colours appear only on findings, frames, counts and score bands. A severity colour on anything else reads as an alarm.",
        "section": "colors"
      },
      {
        "name": "The Never Colour Alone Rule",
        "body": "Every severity label prints the word and a distinct icon shape (octagon, triangle, circle, info). Frames carry a number; empty matrix cells print a dot.",
        "section": "colors"
      },
      {
        "name": "The Readout Rule",
        "body": "If it is measured, counted or identified (score, count, ID, URL, time, percentage), it is set in tabular Geist Mono. Prose never is.",
        "section": "typography"
      },
      {
        "name": "The Small Uppercase Rule",
        "body": "Uppercase with 0.06em tracking is only for column headers, field labels and severity/band names. It never sits above a heading as decoration.",
        "section": "typography"
      },
      {
        "name": "The Tone Not Shadow Rule",
        "body": "Panels separate from the ground by one tonal step and a hairline. A new surface gets a shadow only if it is a capture on the scan grid or a locked frame.",
        "section": "elevation"
      }
    ],
    "dos": [
      "**Do** keep cyan for interaction and scan state only (The One Beam Rule).",
      "**Do** print the severity word and its icon every time a severity is shown.",
      "**Do** set every score, count, ID, URL, timing and percentage in tabular Geist Mono.",
      "**Do** separate report blocks with 1px hairlines and tonal steps before reaching for a box or a shadow.",
      "**Do** number located findings with two-digit tags and repeat the same number on the table row.",
      "**Do** keep radii between 2px and 8px for new surfaces; 12px is the ceiling.",
      "**Do** hold AA contrast in both themes, using the `-fg` severity tokens for text."
    ],
    "donts": [
      "**Don't** build screens from score tiles or rows of same-size cards; the report is a register, not a dashboard.",
      "**Don't** use severity colours for decoration, branding or emphasis outside findings.",
      "**Don't** add shadows to panels, buttons or popovers beyond the two in the shadow vocabulary.",
      "**Don't** put uppercase tracked labels above headings as decoration.",
      "**Don't** introduce a second accent hue or a display typeface; the scale stops at 44px."
    ]
  }
}
